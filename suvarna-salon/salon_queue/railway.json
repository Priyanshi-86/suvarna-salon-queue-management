{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "RAILPACK", "buildCommand": "python manage.py collectstatic --noinput" },
  "deploy": {
    "preDeployCommand": ["python manage.py migrate --noinput", "python manage.py bootstrap_data"],
    "startCommand": "gunicorn config.wsgi --bind 0.0.0.0:${PORT:-8080} --workers 2",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
